generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/math-ascension.db"
}

model SpecPoint {
  id           String  @id
  title        String
  topic        String  // Number | Algebra | Ratio | Geometry | Probability | Statistics
  description  String
  edexcel_ref  String?
  prerequisites String @default("[]") // JSON array of SpecPoint ids
  difficulty    Int    @default(5)    // 1–10
  status        String @default("unverified") // verified | unverified

  progress UserProgress[]
  attempts AttemptLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProgress {
  id          String   @id @default(cuid())
  specPointId String
  mastery     Int      @default(0)    // 0–1000
  confidence  Float    @default(0.0)  // 0–1
  lastReviewed DateTime?
  decayRate   Float    @default(0.1)

  specPoint SpecPoint @relation(fields: [specPointId], references: [id])

  @@unique([specPointId])
}

model AttemptLog {
  id           String   @id @default(cuid())
  specPointId  String
  correct      Boolean
  responseTime Int      // milliseconds
  timestamp    DateTime @default(now())
  errorType    String?

  specPoint SpecPoint @relation(fields: [specPointId], references: [id])
}
